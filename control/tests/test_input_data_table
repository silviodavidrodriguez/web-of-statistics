from django.test import SimpleTestCase
from django.urls import reverse


class ControlInputDataTableTests(SimpleTestCase):
    def test_control_page_contains_immediate_paste_preview_markup(self):
        response = self.client.get(
            reverse("control") + "?tab=variables&tool=xbar_r"
        )

        self.assertEqual(response.status_code, 200)
        self.assertContains(response, 'class="control-textarea data-paste-area"')
        self.assertContains(response, 'data-preview-for="data"')
        self.assertContains(response, 'data-preview-wrapper-for="data"')
        self.assertNotContains(response, "Edit data")
        self.assertNotContains(response, "row(s)")

    def test_markdown_table_is_accepted_without_server_preview_controls(self):
        response = self.client.post(
            reverse("control") + "?tab=variables&tool=xbar_r",
            {
                "action": "calculate",
                "data": (
                    "| 3.1 | 2.9 | 3.2 | 3.1 | 3.3 |\n"
                    "| --: | --: | --: | --: | --: |\n"
                    "| 3 | 2.8 | 2.9 | 3.2 | 3.1 |\n"
                    "| 3.2 | 3.1 | 3.1 | 3 | 3.2 |\n"
                    "| 3.3 | 3.2 | 3.1 | 3.2 | 3.1 |\n"
                    "| 3 | 3.1 | 3.2 | 3 | 3.1 |\n"
                    "| 3.1 | 3.2 | 3.3 | 3.2 | 3.1 |\n"
                    "| 3 | 3.1 | 3 | 2.9 | 3.2 |\n"
                    "| 3.1 | 3.1 | 3 | 3 | 3.2 |"
                ),
            },
        )

        self.assertEqual(response.status_code, 200)
        self.assertNotContains(response, "Non-numeric value detected")
        self.assertContains(response, "X\u0304 Chart")
        self.assertContains(response, 'data-preview-for="data"')
        self.assertNotContains(response, "Edit data")
        self.assertNotContains(response, "8 rows")
